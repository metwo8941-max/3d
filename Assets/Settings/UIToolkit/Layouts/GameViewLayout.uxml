<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Settings/UIToolkit/Styles/GameViewStyles.uss?fileID=7433441132597879392&amp;guid=6ebbbe798c96bf344b8b9360316b9108&amp;type=3#HudStyles" />
    <ui:VisualElement name="Screen" class="screen-container">
        <ui:VisualElement name="Panel" class="panel-container">
            <ui:VisualElement name="CenterContainer" class="center-container">
                <ui:Label name="CenterLabel" text=""/>
            </ui:VisualElement>
            <ui:VisualElement class="corner-container alignUpperLeft">
                <ui:Label name="UpperLeftLabel" text="Lives: 003"/>
            </ui:VisualElement>

            <ui:VisualElement class="corner-container alignUpperRight">
                <ui:Label name="UpperRightLabel" text="Score: 000"/>
            </ui:VisualElement>

            <ui:VisualElement name="LowerLeftContainer" class="corner-container alignLowerLeft">
                <ui:Label name="LowerLeftLabel" text="Instructions..."/>
            </ui:VisualElement>

            <ui:VisualElement name="LowerRightContainer" class="corner-container alignLowerRight">
                <ui:Label name="LowerRightLabel" text="Scene01_Intro"/>
            </ui:VisualElement>

            <ui:VisualElement name="TouchControlsContainer" class="touch-controls-container">
                <ui:VisualElement class="touch-control-cluster touch-control-cluster-left">
                    <ui:VisualElement name="TouchMovePad" class="touch-move-pad">
                        <ui:VisualElement name="TouchMoveKnob" class="touch-move-knob" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="touch-control-cluster touch-control-cluster-right">
                    <ui:VisualElement name="TouchJumpButton" class="touch-jump-button">
                        <ui:Label text="JUMP" class="touch-jump-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
